#!/usr/bin/env python
"""Inbound webhook for Discord messages, fed by the HeraldForward Vencord plugin.

Discord has no read API for a user's own account that is permitted, so the
messages are taken from inside the user's own client: the plugin listens for
the events the client already receives and posts them here. Bound to the
tailnet address of this machine (`discord.webhook_bind`) and authenticated with
one bearer token, `discord.webhook_token`, the same arrangement as the health
webhook.
"""

from __future__ import annotations

import hmac
import json
import os
import pathlib
import shutil
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

_EXT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(_EXT / "lib"))
_root = os.environ.get("HERALD_ROOT")
if not _root and (_herald := shutil.which("herald")):
    _root = str(pathlib.Path(_herald).resolve().parents[1])
if _root:
    sys.path.insert(0, str(pathlib.Path(_root) / "lib"))

from herald import config, db  # noqa: E402
import discord_ingest  # noqa: E402
import discord_latency  # noqa: E402

PORT = 8791
MAX_BODY = 2_000_000


class Handler(BaseHTTPRequestHandler):
    timeout = 30

    def log_message(self, fmt, *args):  # noqa: A003
        print(f"{self.address_string()} - {fmt % args}", flush=True)

    def _reply(self, code: int, body: dict):
        payload = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def do_POST(self):  # noqa: N802
        if self.path != "/ingest":
            return self._reply(404, {"error": "not found"})
        expected = config.secret("discord.webhook_token")
        given = (self.headers.get("Authorization") or "").removeprefix("Bearer ")
        if not expected or not hmac.compare_digest(given, expected):
            return self._reply(401, {"error": "bad token"})
        try:
            length = int(self.headers.get("Content-Length", "0"))
            if length > MAX_BODY:
                return self._reply(413, {"error": "too large"})
            events = json.loads(self.rfile.read(length) or b"{}").get("events", [])
        except (ValueError, json.JSONDecodeError):
            return self._reply(400, {"error": "bad json"})
        con = db.connect()
        try:
            stored = discord_ingest.ingest(con, events)
        finally:
            con.close()
        self._reply(200, {"stored": stored})


def main():
    bind = config.get("discord.webhook_bind")
    if not bind:
        raise SystemExit("set discord.webhook_bind to this machine's tailnet address")
    with db.session() as con:
        discord_latency.start_observation(con)
    print(f"discord webhook listening on {bind}:{PORT}", flush=True)
    ThreadingHTTPServer((bind, PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
